# SENTRYA v0.1
# Never commit a real database credential.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
SENTRYA_ENV=development
# Required only for privileged demo mutations. Generate a long random secret.
SENTRYA_DEMO_ADMIN_KEY=

# Optional pilot key for HMAC-signed agent requests. Use a separate random secret.
SENTRYA_AGENT_SIGNING_KEY=

# GitHub App pilot integration. Keep the private key only in the deployment secret store.
SENTRYA_GITHUB_APP_ID=
SENTRYA_GITHUB_INSTALLATION_ID=
SENTRYA_GITHUB_PRIVATE_KEY=
